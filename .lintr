linters: linters_with_defaults(
    line_length_linter(100),
    object_name_linter(styles = "snake_case"),
    object_usage_linter = NULL,
    cyclocomp_linter = NULL
  )
encoding: "UTF-8"
exclusions: list(
    "vignettes/get-started.Rmd" = list(quotes_linter = Inf),
    "vignettes/defining-products.Rmd" = list(quotes_linter = Inf),
    "vignettes/recording-defect.Rmd" = list(quotes_linter = Inf),
    "data-raw/example-products.R" = list(quotes_linter = Inf),
    "tests/fixtures",
    "tests/fixtures-full",
    "vignettes/heights.Rmd" = list(quotes_linter = Inf),
    "vignettes/stem-measurements.Rmd" = list(quotes_linter = Inf),
    "vignettes/biomass-carbon.Rmd" = list(quotes_linter = Inf),
    "vignettes/bucking-strategy.Rmd" = list(quotes_linter = Inf),
    "vignettes/tree-lists.Rmd" = list(quotes_linter = Inf),
    "vignettes/taper-equations.Rmd" = list(quotes_linter = Inf)
  )
